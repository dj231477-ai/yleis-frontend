# Supabase — obligatorio
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Plasmic — FASE 3: zona pública (landing, /profesores, /blog, etc.)
# Obtener en: studio.plasmic.app → tu proyecto → URL (el ID está en la URL del proyecto)
NEXT_PUBLIC_PLASMIC_PROJECT_ID=
NEXT_PUBLIC_PLASMIC_API_TOKEN=

# App
NEXT_PUBLIC_APP_URL=https://yleis.co

# Emails - Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Yleis <hola@yleis.co>
RESEND_REPLY_TO=hola@yleis.co
EMAIL_WEBHOOK_SECRET=

# Cal.com - opcional hasta completar integracion
NEXT_PUBLIC_CALCOM_URL=

# Google Calendar - conexion del profesor para generar Meet automatico
# Mismo Client ID/Secret que el login con Google, solo hay que agregarle
# el scope calendar.events en Google Cloud Console y registrar el redirect
# URI: {NEXT_PUBLIC_APP_URL}/api/teacher/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
